class UsageError(Exception):
    """Any exit-2 condition (spec §4.2)."""


class NoTargetError(Exception):
    """Target does not exist at startup (exit 3)."""

    def __init__(self, path):
        super().__init__(str(path))
        self.path = path


# ---------------------------------------------------------------------------
# Selection layer — pure, unit-tested (spec §5, design §12.3 item 3)
# ---------------------------------------------------------------------------

def parse_extensions(spec):
    """Parse an --extensions value into a set (spec §4.1/§4.2)."""
    if spec is None:
        return set(DEFAULT_EXTENSIONS.split(","))
    tokens = [t.strip().lower() for t in spec.split(",")]
    tokens = [t for t in tokens if t != ""]
    if not tokens:
        raise UsageError("--extensions: empty list")
    for t in tokens:
        if "/" in t:
            raise UsageError(f"--extensions: '{t}' contains '/'")
        if t.startswith("."):
            raise UsageError(f"--extensions: '{t}' must not start with '.'")
    return set(tokens)


def extension_of(name):
    if "." not in name:
        return None
    return name.rsplit(".", 1)[1].lower()


def scan_candidates(dir_path, exts):
    """List the candidates of dir_path (spec §5.1).

    Returns [(path, mtime_ns, size)] with absolute paths. Never raises:
    a missing/unreadable directory yields [].
    """
    out = []
    try:
        entries = list(os.scandir(dir_path))
    except OSError:
        return out
    for entry in entries:
        name = entry.name
        if name.startswith("."):
            continue
        ext = extension_of(name)
        if ext is None or ext not in exts:
            continue
        try:
            st = entry.stat(follow_symlinks=True)
        except OSError:
            continue  # broken symlink etc.; may become valid on a later rescan
        if not statmod.S_ISREG(st.st_mode):
            continue
        out.append((os.path.join(dir_path, name), st.st_mtime_ns, st.st_size))
    return out


class Observed:
    """Per-path observed state (spec §5.3)."""
    __slots__ = ("mtime_ns", "size", "last_change_mono")

    def __init__(self, mtime_ns, size, last_change_mono):
        self.mtime_ns = mtime_ns
        self.size = size
        self.last_change_mono = last_change_mono


def update_observed(obs_map, cands, now_mono, now_wall):
    """Update per-path observed state (spec §5.3). Mutates and returns obs_map."""
    seen = set()
    for path, mtime_ns, size in cands:
        seen.add(path)
        prev = obs_map.get(path)
        if prev is None:
            # First sighting: presume the last change happened at the file's
            # own mtime (clamped to now) — the mtime-age fast path (§5.3):
            # a pre-existing file older than the window settles immediately.
            age = max(0.0, now_wall - mtime_ns / 1e9)
            obs_map[path] = Observed(mtime_ns, size, now_mono - age)
        elif (prev.mtime_ns, prev.size) != (mtime_ns, size):
            obs_map[path] = Observed(mtime_ns, size, now_mono)
        # else: unchanged — keep last_change_mono
    for p in [p for p in obs_map if p not in seen]:
        del obs_map[p]
    return obs_map


def is_settled(obs, now_mono, now_wall, window_s):
    """Spec §5.3: quiet for the settle window by both observed and mtime age."""
    if obs is None:
        return False
    return ((now_mono - obs.last_change_mono >= window_s)
            and (now_wall - obs.mtime_ns / 1e9 >= window_s))


class Snapshot:
    """Identity of the currently displayed image (spec §2)."""
    __slots__ = ("path", "mtime_ns", "size", "width", "height")

    def __init__(self, path, mtime_ns, size, width=0, height=0):
        self.path = path
        self.mtime_ns = mtime_ns
        self.size = size
        self.width = width
        self.height = height


def pick_best(settled, snapshot):
    """Spec §5.2: which path belongs on display, or None.

    settled: [(path, mtime_ns, size)]; snapshot: Snapshot | None.
    """
    if not settled:
        return None
    cur_unchanged = False
    if snapshot is not None:
        for path, mtime_ns, size in settled:
            if path == snapshot.path:
                if (mtime_ns, size) == (snapshot.mtime_ns, snapshot.size):
                    cur_unchanged = True
                else:
                    # In-place update of the displayed file (R4): reload it,
                    # whatever the mtime direction.
                    return path
                break
    if cur_unchanged:
        # Switch to a *different* file only if strictly newer (newer-only).
        newer = [c for c in settled
                 if c[0] != snapshot.path and c[1] > snapshot.mtime_ns]
        if newer:
            return max(newer, key=lambda c: (c[1], c[0]))[0]
        return snapshot.path
    # No valid current: the overall newest (ties → lexicographically greatest).
    return max(settled, key=lambda c: (c[1], c[0]))[0]


def newest_for_report(cands):
    """`--print` (spec §4.3): greatest mtime; ties → greatest name. No settle."""
    if not cands:
        return None
    return max(cands, key=lambda c: (c[1], c[0]))[0]


# ---------------------------------------------------------------------------
# Launch context & target resolution (rev 0.8; R20–R22, §4.6)
# ---------------------------------------------------------------------------

def has_controlling_tty():
    """True iff this process has a controlling terminal (R22 probe)."""
    try:
        fd = os.open("/dev/tty", os.O_RDONLY)
    except OSError:
        return False
    os.close(fd)
    return True


def is_gui_context(environ=None, has_ctty=None):
    """R22: GUI context ⇔ DESKTOP_STARTUP_ID set, or no controlling terminal.

    Documented convenience heuristic (§4.6). `environ` and `has_ctty` are
    injectable for unit tests; production uses os.environ + a live probe.
    """
    env = os.environ if environ is None else environ
    if env.get("DESKTOP_STARTUP_ID"):
        return True
    if has_ctty is None:
        has_ctty = has_controlling_tty()
    return not has_ctty


def uri_to_path(target):
    """Accept `file://` URIs as targets (the .desktop entry's %U, R20)."""
    if target.startswith("file://"):
        return urllib.parse.unquote(urllib.parse.urlparse(target).path)
    return target


def resolve_target(raw_target, gui_context):
    """Resolve the target to (mode, abs_path); mode in {"dir","file","none"}.

    R21: dir -> directory mode; image file -> single-file mode (default
    extension set only); other file -> UsageError (exit 2); missing ->
    NoTargetError (exit 3). R22: no target -> CWD in a terminal context,
    idle state ("none") in a GUI context.
    """
    if raw_target is not None:
        path = os.path.abspath(uri_to_path(raw_target))
        if not os.path.exists(path):
            raise NoTargetError(path)
        if os.path.isdir(path):
            return "dir", path
        if extension_of(os.path.basename(path)) in DEFAULT_EXTENSIONS_SET:
            return "file", path
        raise UsageError(
            "target is not a directory or a supported image file: " + path)
    if gui_context:
        return "none", None
    return "dir", os.path.abspath(".")


