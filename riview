def build_parser():
    p = argparse.ArgumentParser(
        prog="riview",
        description="Reloading Image Viewer — watch a directory and display "
                    "its newest image.",
    )
    p.add_argument("target", nargs="?", default=None,
                   help="directory or image file to watch (default: the "
                        "current working directory when launched from a "
                        "terminal; idle state in a GUI context — R22)")
    p.add_argument("--extensions", default=DEFAULT_EXTENSIONS, metavar="LIST",
                   help="comma-separated candidate extensions (default: %(default)s)")
    p.add_argument("--stable-ms", type=int, default=DEFAULT_STABLE_MS, metavar="MS",
                   help="settle window in milliseconds; 0 disables (default: %(default)s)")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--cycle", action="store_true",
                   help="start in cycle mode (the slide show) at launch — "
                        "first slide the oldest settled image (R29); an "
                        "optional SECONDS value directly after the flag "
                        f"sets the initial cycle time (default: {DEFAULT_CYCLE_S}"
                        " s); mutually exclusive with --cycle-time")
    g.add_argument("--cycle-time", type=int, default=None, metavar="SECONDS",
                   help="cycle time for cycle mode (R27/R28) in integer "
                        f"seconds; minimum 1 (default: {DEFAULT_CYCLE_S}); "
                        "Up/Down adjust it at runtime; mutually exclusive "
                        "with --cycle")
    p.add_argument("--cycle-value", type=int, default=None,
                   metavar="SECONDS", help=argparse.SUPPRESS)
    # (the plumbing for `--cycle SECONDS` — see _cycle_argv)
    p.add_argument("--poll", type=float, default=None, metavar="SECONDS",
                   help="poll every SECONDS instead of using inotify (also the "
                        "fallback interval when given)")
    p.add_argument("--max-dim", type=int, default=0, metavar="PX",
                   help="cap on the longer side of the decoded image, in pixels; "
                        "0 = no cap (default: %(default)s)")
    p.add_argument("--fit", "--fit-window", dest="fit",
                   choices=("ratio", "exact", "off"), default="ratio",
                   help="window fit mode (R24): how the window is sized to "
                        "the first displayed image — ratio: the image's "
                        "aspect ratio within the smaller of the 80%% budget "
                        "and the 1600x1200 COSMIC cap (default; D15); "
                        "exact: 1:1 logical pixels, capped at the screen "
                        "minus the header; off: the pre-image size only. "
                        "r re-fits on demand (any mode except off).")
    p.add_argument("--fullscreen", action="store_true",
                   help="start in full screen")
    p.add_argument("--print", action="store_true",
                   help="print the absolute path of the image riview would "
                        "display (or 'none') and exit; no GUI, no settle wait")
    p.add_argument("--install-desktop", action="store_true",
                   help="install the per-user .desktop entry + icon (R20) "
                        "and exit")
    p.add_argument("--uninstall-desktop", action="store_true",
                   help="remove the per-user .desktop entry + icon (R20) "
                        "and exit")
    p.add_argument("--version", action="store_true",
                   help="print version and exit")
    return p


def _cycle_argv(argv):
    """`--cycle SECONDS` plumbing (R29): argparse cannot distinguish the
    optional seconds value from the positional target (a `nargs='?'`
    flag would swallow `riview --cycle <dir>`), so the explicit form is
    rewritten to the hidden --cycle-value before parsing. Only a token
    that looks like a number is taken as the value (a directory called
    `5` must still be addressable as `riview 5 --cycle`)."""
    out = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if (a == "--cycle" and i + 1 < len(argv)
                and re.fullmatch(r"-?\d+(\.\d+)?", argv[i + 1])):
            out.extend(["--cycle", "--cycle-value", argv[i + 1]])
            i += 2
        else:
            out.append(a)
            i += 1
    return out


def validate(args):
    """Apply §4.2 option validation; raises UsageError (exit 2).

    Target resolution (exit 2/3, R21/R22) happens in main() via
    resolve_target, since it depends on the launch context.
    """
    if args.stable_ms < 0:
        raise UsageError(f"--stable-ms must be >= 0 (got {args.stable_ms})")
    if args.poll is not None and args.poll <= 0:
        raise UsageError(f"--poll must be > 0 (got {args.poll})")
    if args.max_dim < 0:
        raise UsageError(f"--max-dim must be >= 0 (got {args.max_dim})")
    # Cycle time (R28, §4.2): `--cycle [SECONDS]` (the value is plumbed
    # through the hidden --cycle-value, _cycle_argv) sets the initial
    # cycle time; --cycle and --cycle-time are mutually exclusive.
    if args.cycle_value is not None and args.cycle_time is not None:
        raise UsageError("--cycle's SECONDS value and --cycle-time are "
                         "mutually exclusive")
    if args.cycle_value is not None and args.cycle_value < 1:
        raise UsageError(f"--cycle must be >= 1 second "
                         f"(got {args.cycle_value})")
    if args.cycle_time is not None:
        if args.cycle_time < 1:
            raise UsageError(f"--cycle-time must be >= 1 "
                             f"(got {args.cycle_time})")
    elif args.cycle_value is not None:
        args.cycle_time = args.cycle_value
    else:
        args.cycle_time = DEFAULT_CYCLE_S
    if args.print and args.fullscreen:
        raise UsageError("--print is incompatible with --fullscreen")
    args.exts = parse_extensions(args.extensions)
    return args


def run_print(mode, path, args):
    """R12: headless query — print the path of the image riview would
    display (absolute path, or 'none'); point-in-time, no settle wait."""
    if mode == "file":
        print(path)
        return OK
    cands = scan_candidates(path, args.exts)
    best = newest_for_report(cands)
    print(os.path.abspath(best) if best else "none")
    return OK


def desktop_paths():
    """R20: per-user .desktop entry and icon locations (XDG_DATA_HOME-aware)."""
    data = os.path.expanduser(
        os.environ.get("XDG_DATA_HOME") or "~/.local/share")
    return (os.path.join(data, "applications", APP_ID + ".desktop"),
            os.path.join(data, "icons", "hicolor", "scalable", "apps",
                         APP_ID + ".svg"))


def run_desktop_install(args):
    """R20: install/uninstall the desktop entry + icon (headless, idempotent)."""
    if args.install_desktop and args.uninstall_desktop:
        raise UsageError(
            "--install-desktop and --uninstall-desktop are mutually exclusive")
    if args.target is not None or args.print or args.fullscreen:
        raise UsageError(
            "desktop install/uninstall cannot be combined with a target, "
            "--print, or --fullscreen")
    entry, icon = desktop_paths()
    if args.install_desktop:
        for p in (entry, icon):
            os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(entry, "w", encoding="utf-8") as f:
            f.write(DESKTOP_ENTRY.format(exec=os.path.realpath(__file__),
                                         icon=APP_ID, mime=DESKTOP_MIMETYPES))
        with open(icon, "w", encoding="utf-8") as f:
            f.write(ICON_SVG)
        return OK
    # --uninstall-desktop: idempotent removal; a note when there is nothing.
    removed = False
    for p in (entry, icon):
        try:
            os.remove(p)
            removed = True
        except FileNotFoundError:
            pass
    if not removed:
        print("riview: note: no desktop entry installed; nothing removed",
              file=sys.stderr)
    return OK


# ---------------------------------------------------------------------------
# GUI (spec §6–§7, design §12.4–§12.7).
# GTK/GdkPixbuf are imported here and in the decoder thread only, so that
# `--print` and the desktop flags stay clean in display-less sessions (spec
# §13.3).
# ---------------------------------------------------------------------------

def _gui_classes():
    """Define the GUI-layer classes. GTK is imported here (lazily) so that
    `--print` and the desktop flags stay clean in display-less sessions
    (spec §13.3).

    Split out of run_gui so the inotify/decode plumbing (Decoder, Watcher)
    is reachable from the headless test suite.
    """
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    gi.require_version("Adw", "1")
    gi.require_version("Pango", "1.0")
    from gi.repository import Adw, Gtk, Gdk, Gio, GLib, Pango

    class Decoder:
        """Single decode worker thread + queues (design §12.4/§12.5)."""

        def __init__(self):
            self._req = queue.Queue()
            self._res = queue.Queue()
            self._thread = threading.Thread(target=self._run,
                                            name="riview-decode", daemon=True)
            self._thread.start()

        def _run(self):
            import gi as _gi
            _gi.require_version("GdkPixbuf", "2.0")
            from gi.repository import GdkPixbuf
            pb = GdkPixbuf.Pixbuf
            while True:
                item = self._req.get()
                if item is None:
                    return
                gen, path, w, h = item
                try:
                    # Never upscale beyond the source's native size (§7.1).
                    # get_file_info returns (format|None, width, height) —
                    # (None, -1, -1) when the header cannot be read.
                    info = pb.get_file_info(path)
                    sw = sh = 0
                    if info is not None and len(info) == 3:
                        _fmt, b, c = info
                        if isinstance(b, int) and isinstance(c, int) and b > 0 and c > 0:
                            sw, sh = b, c
                    if sw:
                        tw, th = min(w, sw), min(h, sh)
                    else:
                        tw, th = w, h
                    pixbuf = pb.new_from_file_at_scale(path, max(tw, 1), max(th, 1), True)
                    if pixbuf is None:
                        raise GLib.Error("pixbuf load returned null")
                    self._res.put((gen, path, pixbuf, None))
                except Exception as e:
                    self._res.put((gen, path, None, e))

        def request(self, gen, path, w, h):
            self._req.put((gen, path, w, h))

        def results(self):
            out = []
            while True:
                try:
                    out.append(self._res.get_nowait())
                except queue.Empty:
                    return out

        def stop(self):
            self._req.put(None)

    class Watcher:
        """Directory watcher (spec §6): inotify via Gio.File.monitor with
        coalesced rescans, optional polling, deleted-directory recovery."""

        def __init__(self, path, poll_s, on_rescan):
            self.path = path
            self.poll_s = poll_s
            self.on_rescan = on_rescan
            self.monitor = None
            self.inode = None
            self._known_gone = False
            self._tick = 0
            self._rescan_pending = False
            self._rescan_id = None
            self._poll_id = None
            self._recheck_id = None

        def start(self):
            st = os.stat(self.path)
            self.inode = (st.st_dev, st.st_ino)
            if self.poll_s is None:
                self._make_monitor()
                # Safety net: an inotify monitor can go silent (directory
                # deleted/recreated, watch dropped) and then no events ever
                # arrive — so inotify mode also re-stats the path periodically.
                self._recheck_id = GLib.timeout_add(RECHECK_MS, self._recheck)
            else:
                self._start_poll()
            self.schedule_rescan(0)

        def stop(self):
            for attr in ("_rescan_id", "_poll_id", "_recheck_id"):
                sid = getattr(self, attr)
                if sid is not None:
                    GLib.source_remove(sid)
                    setattr(self, attr, None)
            self.monitor = None

        def schedule_rescan(self, delay_ms=COALESCE_MS):
            if self._rescan_pending:
                return
            self._rescan_pending = True
            self._rescan_id = GLib.timeout_add(delay_ms, self._do_rescan)

        # -- rescan plumbing ------------------------------------------------
        def _do_rescan(self):
            self._rescan_pending = False
            self._rescan_id = None
            try:
                self.on_rescan()
            except Exception as e:
                print(f"riview: warning: rescan failed: {e}", file=sys.stderr)
            return False

        # -- inotify ---------------------------------------------------------
        def _make_monitor(self):
            try:
                m = Gio.File.new_for_path(self.path).monitor(
                    Gio.FileMonitorFlags.NONE, None)
                m.connect("changed", self._on_changed)
                # NOTE: GInotifyFileMonitor exposes no "cancelled" signal on
                # this GLib; the _recheck timer covers the silent case.
                self.monitor = m
                return True
            except GLib.Error as e:
                print(f"riview: warning: inotify monitor unavailable "
                      f"({e.message}); falling back to polling every "
                      f"{FALLBACK_POLL_S}s", file=sys.stderr)
                self._fallback_poll()
                return False

        def _on_changed(self, monitor, file, other_file, event_type):
            self.schedule_rescan()

        # -- polling / recheck -----------------------------------------------
        def _start_poll(self):
            if self._poll_id is None:
                self._poll_id = GLib.timeout_add(int(self.poll_s * 1000),
                                                 self._poll_tick)

        def _fallback_poll(self):
            if self.poll_s is None:
                self.poll_s = FALLBACK_POLL_S
            self._start_poll()

        def _poll_tick(self):
            # Polling self-heals (the directory is re-statted every tick),
            # so no inode bookkeeping is needed in poll mode.
            self.on_rescan()
            return True

        def _recheck(self):
            """Periodic safety net in inotify mode (spec §6.1, R14).

            inotify watches are per directory *instance*: if the directory
            is deleted and recreated — even under a reused inode number —
            the old monitor is silently dead and no events ever arrive
            again. Re-creating the monitor every tick is a couple of
            syscalls and bounds recovery to RECHECK_MS regardless of how
            the recreation happened; the post-swap rescan re-derives state
            from disk, so nothing is lost in the (microsecond) swap gap.
            """
            if self.poll_s is not None:
                # Fell back to polling: the poll tick covers everything.
                self._recheck_id = None
                return False
            try:
                st = os.stat(self.path)
            except OSError:
                if not self._known_gone:
                    self._known_gone = True
                    self.schedule_rescan(0)  # clear display to waiting state
                return True
            if not statmod.S_ISDIR(st.st_mode):
                return True
            was_gone = self._known_gone
            self._known_gone = False
            cur = (st.st_dev, st.st_ino)
            self.monitor = None
            self._make_monitor()
            if was_gone or (self.inode is not None and cur != self.inode) \
                    or self._tick % 5 == 0:
                self.schedule_rescan(0)  # periodic safety-net rescan too
            self.inode = cur
            self._tick += 1
            return True

    class RiviewWindow(Adw.ApplicationWindow):
        # R18: modifiers allowed on the bare-key shortcuts (Shift + locks).
        # The binding exposes no IS_* masks, so plain masks only (§13.2).
        _PERMITTED_MODS = (int(Gdk.ModifierType.SHIFT_MASK)
                           | int(Gdk.ModifierType.LOCK_MASK))

        def __init__(self, app, args):
            super().__init__(application=app)
            self.args = args
            # Target modes (rev 0.8; R21/R22): "dir", "file", "none".
            self.mode = args.mode
            if self.mode == "file":
                # Single-file mode: watch the containing directory but only
                # ever consider the target path itself (R21).
                self.only_path = args.target_abs
                self.file_name = os.path.basename(self.only_path)
                self.dir_abs = os.path.dirname(self.only_path)
                self.exts = {extension_of(self.file_name)}
                self._subtitle = self.only_path
            else:
                self.only_path = None
                self.file_name = None
                self.dir_abs = args.target_abs or ""
                self.exts = args.exts
                self._subtitle = self.dir_abs
            self.window_s = args.stable_ms / 1000.0
            self.max_dim = args.max_dim
            self.observer = {}
            self.snapshot = None
            self.failed_versions = set()
            self.current_gen = 0
            # Manual navigation (R23, §5.5): pinned_path is the chosen file
            # in manual mode (None = live mode); image_gone is the display
            # state while the pinned file is not a candidate.
            self.pinned_path = None
            self.image_gone = False
            # Window fit (R24, §5.6): the fit mode from --fit, and whether
            # the once-only fit pass has run.
            self.fit_mode = args.fit
            self.fitted = False
            self._last_canvas_click_s = -1.0
            # Cycle mode / slide show (rev 1.6, R27–R29, §5.7): the cycle
            # time (validated, §4.2), the mode flag, the --cycle start
            # (first slide = oldest settled), and the in-progress-interval
            # bookkeeping (R28 rescale: elapsed time is preserved).
            self.cycle_s = args.cycle_time
            self.cycle_mode = False
            self.start_oldest = False
            self.cycle_deadline = None
            self.cycle_interval_start = None
            self._cycle_tick_id = None
            self._cycle_first_req = None
            self._dims = None  # last displayed image's decoded dimensions
            # Full-screen keypress feedback (rev 1.7, R30): the pending
            # 1 s hide timeout (None when no overlay is up).
            self._feedback_id = None

            # Window icon: the desktop icon when installed (R20), else a
            # generic fallback so the decoration still reads "image".
            self.set_icon_name(APP_ID if os.path.exists(desktop_paths()[1])
                               else "image-x-generic")
            self.set_title("riview")

            # -- black canvas (R17): the letterbox around the image ------
            # USER priority beats the theme and libadwaita's own providers.
            css = Gtk.CssProvider()
            css.load_from_string(
                "window { background-color: #000000; }\n"
                ".riview-waiting { color: #ffffff; }\n"
                ".riview-feedback { color: #ffffb5; font-size: 2.5em; "
                "background-color: rgba(70, 70, 70, 0.65); "
                "padding: 10px 18px; border-radius: 8px; }")
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(),
                css,
                Gtk.STYLE_PROVIDER_PRIORITY_USER)

            # -- layout (design §12.7) --------------------------------------
            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

            header = Adw.HeaderBar()
            self.header = header
            self.title_widget = Adw.WindowTitle()
            self.title_widget.set_title("riview")
            self.title_widget.set_subtitle(self._subtitle)
            header.set_title_widget(self.title_widget)

            self.picture = Gtk.Picture()
            # content-fit=CONTAIN keeps the aspect ratio (set_keep_aspect_ratio
            # is deprecated in GTK >= 4.10 and a no-op with CONTAIN).
            self.picture.set_content_fit(Gtk.ContentFit.CONTAIN)
            self.picture.set_can_shrink(True)
            self.picture.set_hexpand(True)
            self.picture.set_vexpand(True)

            self.waiting_label = Gtk.Label()
            self.waiting_label.add_css_class("riview-waiting")
            self.waiting_label.set_halign(Gtk.Align.CENTER)
            self.waiting_label.set_valign(Gtk.Align.CENTER)
            self.waiting_label.set_justify(Gtk.Justification.CENTER)
            # Wrapping for the idle-state message (R22) and long file names.
            self.waiting_label.set_wrap(True)
            self.waiting_label.set_wrap_mode(Pango.WrapMode.WORD)
            self.waiting_label.set_max_width_chars(60)
            self.waiting_label.set_margin_start(24)
            self.waiting_label.set_margin_end(24)
            self.waiting_label.set_visible(False)
            wrap = Gtk.Box()
            wrap.set_halign(Gtk.Align.CENTER)
            wrap.set_valign(Gtk.Align.CENTER)
            wrap.append(self.waiting_label)

            overlay = Gtk.Overlay()
            overlay.set_child(self.picture)
            overlay.add_overlay(wrap)

            # -- full-screen keypress feedback overlay (R30, §5.8) ---------
            # Bottom center of the canvas: its bottom edge sits 10% up
            # from the window bottom (the margin is set from the current
            # allocated height at show time, _show_feedback — GTK4 has no
            # window size-changed signal, and a 1 s transient does not
            # need live resize tracking); 2.5 em pale-yellow text on a
            # semi-transparent gray shade (§12.7); hidden by default;
            # shown for 1 s by _show_feedback.
            self._feedback_label = Gtk.Label()
            self._feedback_label.add_css_class("riview-feedback")
            self._feedback_label.set_halign(Gtk.Align.CENTER)
            self._feedback_label.set_valign(Gtk.Align.END)
            self._feedback_label.set_visible(False)
            overlay.add_overlay(self._feedback_label)

            # -- canvas double-click: toggle full screen (R19) --------------
            # Button 1, two presses within DOUBLE_CLICK_S. The overlay covers
            # picture + letterbox + waiting label (header bar excluded). The
            # binding has no Gtk.GestureMultiPress (§13.2), hence manual.
            dbl = Gtk.GestureClick()
            dbl.set_button(1)
            dbl.connect("pressed", self._on_canvas_click)
            overlay.add_controller(dbl)

            vbox.append(header)
            vbox.append(overlay)
            self.set_content(vbox)

            # -- full screen: image only, no chrome (R16) -----------------
            self.fullscreen_mode = args.fullscreen
            if self.fullscreen_mode:
                header.set_visible(False)

            # -- initial size / full screen (D11, R16) -----------------------
            init_w, init_h = self._init_size()
            self._init_w, self._init_h = init_w, init_h
            self.set_default_size(init_w, init_h)

            # -- debug size watch (RIVIEW_DEBUG, §13.2) ---------------------
            # Logs every window size change with a timestamp. The fit pass
            # is a no-op when the early fit already sized the window, so any
            # change after presentation is NOT caused by riview's resize
            # code — this isolates compositor-side resize interference.
            if os.environ.get("RIVIEW_DEBUG", "") not in ("", "0"):
                self._t0 = time.monotonic()
                self._last_sz = None

                def _sz_watch():
                    try:
                        sz = (self.get_width(), self.get_height())
                    except Exception:
                        sz = None
                    if (sz is not None and sz != (0, 0)
                            and sz != self._last_sz):
                        _dbg(f"SIZE t+{time.monotonic() - self._t0:7.2f}s: "
                             f"{self._last_sz} -> {sz}")
                        self._last_sz = sz
                    return True
                GLib.timeout_add(100, _sz_watch)

            # -- keyboard shortcuts (R18, design §12.9) --------------------
            # Installed before the services so the idle state also has
            # q/f/Esc (R22).
            keys = Gtk.EventControllerKey()
            keys.connect("key-pressed", self._on_key)
            self.add_controller(keys)

            # -- services ------------------------------------------------------
            # Idle state (mode "none", R22): nothing to watch — no decoder,
            # watcher, or pump; the canvas shows the explanatory message.
            if self.mode == "none":
                self.decoder = None
                self.watcher = None
                self._pump_id = None
                self.waiting_label.set_text(IDLE_TEXT)
                self.waiting_label.set_visible(True)
                self.title_widget.set_subtitle("no file")
                return
            self.decoder = Decoder()
            self.watcher = Watcher(self.dir_abs, args.poll, self.on_rescan)
            self.watcher.start()
            self._pump_id = GLib.timeout_add(PUMP_MS, self._pump)
            # --cycle at startup (R29): cycle mode armed before any
            # display; the first displayed image is the OLDEST settled
            # candidate, and its interval starts at the display. Inert in
            # single-file mode (R21) — no cycle for one image.
            if args.cycle and self.mode == "dir":
                self.start_oldest = True
                self._cycle_start()

        def _monitor(self):
            """The monitor the window is on (R24, §12.7), or None.

            Portable chain: the window's current monitor → the primary
            (where the binding exposes it) → the first monitor. This
            system's PyGObject exposes neither get_primary_monitor() nor
            get_monitor(n) (§13.2), so both are getattr-guarded.
            """
            try:
                display = Gdk.Display.get_default()
            except Exception:
                return None
            if display is None:
                return None
            mon = None
            try:
                mon = display.get_monitor_at_surface(self)
            except Exception:
                pass
            if mon is None:
                gpm = getattr(display, "get_primary_monitor", None)
                if callable(gpm):
                    try:
                        mon = gpm()
                    except Exception:
                        mon = None
            if mon is None:
                try:
                    mons = display.get_monitors()
                    if mons:
                        mon = mons[0]
                except Exception:
                    mon = None
            return mon

        def _initial_candidate(self):
            """File the startup rescan will display first (R24 early
            fit, §5.6), or None: the newest file already settled now,
            or the target file itself in single-file mode. A still-
            settling file is not used — the fit pass on first
            displayed load covers it."""
            try:
                now_mono, now_wall = time.monotonic(), time.time()
                if self.mode == "file":
                    return self.only_path if os.path.isfile(self.only_path) \
                        else None
                cands = scan_candidates(self.dir_abs, self.exts)
                update_observed(self.observer, cands, now_mono, now_wall)
                settled = [c for c in cands
                           if is_settled(self.observer.get(c[0]), now_mono,
                                         now_wall, self.window_s)]
                args = getattr(self, "args", None)
                if (args is not None and args.cycle and settled):
                    # --cycle (R29): the first displayed image is the
                    # OLDEST settled candidate — size the window for it
                    # (the fit pass on first displayed load re-measures).
                    return order_cands(settled)[-1][0]
                return pick_best(settled, None)
            except Exception:
                return None

        def _init_size(self):
            """Initial window size (D11 pre-image default; R24 early
            fit).

            Pre-image default: 80% of the monitor, min 900×675. Early
            fit: when the fit mode is not off and a candidate is
            already settled at construction, the window opens *directly*
            at the fit size — set_default_size before presentation is
            the only reliable client-side window sizing on GTK >= 4.14
            bindings (§13.2); the post-map fit pass on first displayed
            load remains as the safety net (it also covers still-
            settling files, and the 47 px header estimate used here vs.
            the allocated height used there). Exception: 1280×960.
            """
            try:
                box = self._monitor_box()
                if box is None:
                    raise LookupError("no monitor")
                box_w, box_h, sw, sh, header_h, sf = box
                if (self.fit_mode != "off" and self.mode != "none"
                        and not self.fullscreen_mode):
                    cand = self._initial_candidate()
                    dims = probe_dimensions_file(cand) \
                        if cand is not None else None
                    if dims is not None:
                        size = fit_window(self.fit_mode, dims[0], dims[1],
                                          box_w, box_h, sw, sh, header_h,
                                          sf)
                        if size is not None:
                            _dbg(f"early fit: dims={dims} -> {size}")
                            return size
                return box_w, box_h
            except Exception:
                return 1280, 960

        def _monitor_box(self):
            """Fit geometry inputs (R24, §12.7), or None.

            Returns (box_w, box_h, screen_w, screen_h, header_h, sf): the
            80% pre-image budget box (D11 semantics, min 900x675), the full
            monitor in logical pixels, the header height, and the window's
            own scale factor (the current monitor's in mixed-DPI). The
            monitor is the one the window is currently on.
            """
            mon = self._monitor()
            if mon is None:
                return None
            screen = _monitor_logical_size(mon)
            if screen is None:
                return None
            screen_w, screen_h = screen
            if screen_w <= 0 or screen_h <= 0:
                return None
            box_w = max(int(screen_w * 0.8), 900)
            box_h = max(int(screen_h * 0.8), 675)
            header_h = 0
            if self.header is not None:
                # get_height() (GTK >= 4.10). The deprecated
                # get_allocated_height() is only called when get_height is
                # missing (older binding) — calling it here even to probe a
                # zero allocation emits a DeprecationWarning (§13.2).
                get_h = getattr(self.header, "get_height", None)
                if callable(get_h):
                    try:
                        header_h = get_h()
                    except Exception:
                        header_h = 0
                else:
                    try:
                        header_h = self.header.get_allocated_height()
                    except Exception:
                        header_h = 0
            if not header_h:  # not allocated yet (or no header): fallback
                header_h = 47
            sf = self.get_scale_factor() or 1
            return box_w, box_h, screen_w, screen_h, header_h, sf

        def decode_target(self):
            # 2x scale_factor x window, capped by --max-dim on the longer side.
            w = self.get_width() or self._init_w
            h = self.get_height() or self._init_h
            sf = self.get_scale_factor() or 1
            W = max(OVERSAMPLE * sf * w, 1)
            H = max(OVERSAMPLE * sf * h, 1)
            if self.max_dim > 0:
                L = max(W, H)
                if L > self.max_dim:
                    k = self.max_dim / L
                    W = max(int(W * k), 1)
                    H = max(int(H * k), 1)
            return W, H

        # -- rescan + selection (spec §5/§6) ---------------------------------
        def on_rescan(self):
            cands = scan_candidates(self.dir_abs, self.exts)
            if self.only_path is not None:  # single-file mode (R21)
                cands = [c for c in cands if c[0] == self.only_path]
            now_mono = time.monotonic()
            now_wall = time.time()
            update_observed(self.observer, cands, now_mono, now_wall)
            if self.cycle_mode:  # slide show (R27, §5.7): hold the display
                self._rescan_cycle(cands, now_mono, now_wall)
                return
            if self.pinned_path is not None:  # manual mode (R23, §5.5)
                self._rescan_pinned(cands, now_mono, now_wall)
                return
            settled = [c for c in cands
                       if is_settled(self.observer[c[0]], now_mono, now_wall,
                                     self.window_s)]
            best = pick_best(settled, self.snapshot)
            if best is None:
                self.show_waiting(None)
                return
            obs = self.observer[best]
            if (self.snapshot is not None and best == self.snapshot.path
                    and obs.mtime_ns == self.snapshot.mtime_ns
                    and obs.size == self.snapshot.size):
                return  # already showing this exact file version
            # Dual buffer: the display is touched only in _on_load_ok (§5.4).
            self.current_gen += 1
            self.decoder.request(self.current_gen, best, *self.decode_target())

        def _rescan_pinned(self, cands, now_mono, now_wall):
            """Manual-mode rescan (R23, §5.5): the display is pinned to
            self.pinned_path; live following (R1/R3) is suspended."""
            pinned = self.pinned_path
            if pinned not in [c[0] for c in cands]:
                # Pin lost → image-gone state. The pin PERSISTS: the file
                # reappearing (and settling) restores the display, and `n`
                # exits the state.
                if not self.image_gone:
                    self.show_image_gone()
                return
            obs = self.observer[pinned]
            if (self.snapshot is not None and pinned == self.snapshot.path
                    and obs.mtime_ns == self.snapshot.mtime_ns
                    and obs.size == self.snapshot.size):
                return  # already showing this exact pinned version
            if not is_settled(obs, now_mono, now_wall, self.window_s):
                # A new version is still settling (or the just-reappeared
                # file): hold the current display / message (R4/R6).
                return
            # In-place update settled (R4) — or the pin reappeared after
            # being gone (no snapshot / different path): (re)display it.
            self.current_gen += 1
            self.decoder.request(self.current_gen, pinned, *self.decode_target())

        # -- cycle mode (rev 1.6, R27–R29, §5.7) --------------------------------
        def _rescan_cycle(self, cands, now_mono, now_wall):
            """Cycle-mode rescan (R27, §5.7): the display holds like a pin
            on the displayed path — live following (R3) is suspended; an
            in-place update of the shown slide reloads once settled (R4);
            a deleted shown slide holds the last decoded frame (no
            image-gone state while cycling). The first display (armed
            `c` / `--cycle`, snapshot None) selects the first slide and
            starts the in-progress interval at the display."""
            settled = [c for c in cands
                       if is_settled(self.observer[c[0]], now_mono, now_wall,
                                     self.window_s)]
            ordered = order_cands(settled)
            if not ordered:
                if self.snapshot is None and not self.image_gone:
                    self.show_waiting(None)
                return
            if self.snapshot is not None:
                path = self.snapshot.path
                if path not in [c[0] for c in cands]:
                    return  # slide deleted: hold the last decoded frame
                obs = self.observer[path]
                if (obs.mtime_ns, obs.size) == (self.snapshot.mtime_ns,
                                                self.snapshot.size):
                    return
                if not is_settled(obs, now_mono, now_wall, self.window_s):
                    return  # new version still settling: hold (R4)
                self._cycle_request(path)  # in-place update settled (R4)
                return
            # No display yet: first slide (armed `c` / --cycle, R27/R29)
            if self._cycle_first_req is not None:
                return  # first display in flight: keep the interval
            target = cycle_first(ordered, self.start_oldest,
                                 self.failed_versions)
            if target is None:
                self.show_waiting(None)  # every candidate failed (R15)
                return
            self.start_oldest = False
            obs = self.observer.get(target)
            self._cycle_first_req = (target,
                                     obs.mtime_ns if obs else -1,
                                     obs.size if obs else -1)
            now = time.monotonic()
            self.cycle_interval_start = now
            self.cycle_deadline = now + self.cycle_s
            self._cycle_request(target)

        def _show_feedback(self, text):
            """R30 (§5.8): the 1 s on-canvas overlay — full screen only
            (windowed mode keeps the header as the feedback channel), purely
            cosmetic (it touches no cycle, selection, decode, or sizing
            state). A further feedback keypress replaces the text and
            restarts the timer (last wins); a None text (no-op keypress)
            leaves the label and any running timer untouched. The bottom
            edge is placed 10% up from the window bottom using the current
            allocated height (no resize signal is tracked — §12.7)."""
            if not self.fullscreen_mode or text is None:
                return
            self._feedback_label.set_margin_bottom(
                int(self.get_height() * FEEDBACK_BOTTOM_FRAC))
            self._feedback_label.set_text(text)
            self._feedback_label.set_visible(True)
            if self._feedback_id is not None:
                GLib.source_remove(self._feedback_id)
                self._feedback_id = None
            self._feedback_id = GLib.timeout_add(FEEDBACK_MS,
                                                 self._feedback_hide)

        def _feedback_hide(self):
            """R30: drop the overlay (the 1 s timer's callback, and the
            immediate dismissal on a full-screen toggle / shutdown).
            No-argument — the GLib timeout contract (§13.2)."""
            if self._feedback_id is not None:
                GLib.source_remove(self._feedback_id)
                self._feedback_id = None
            self._feedback_label.set_visible(False)

        def _cycle_start(self):
            """c (R27) / --cycle (R29): enter cycle mode.

            No-op while already cycling and in single-file mode / the idle
            state. The pin is dropped (the cycle is not a pin — it
            advances); the first advance is a full cycle time away, and
            with an empty display the interval is (re)started at the
            first display (§5.7). No effect in the idle state (no
            directory) and single-file mode (R21). Returns whether the
            cycle actually started (R30 feedback).
            """
            if (self.cycle_mode or self.mode != "dir"
                    or self.decoder is None):
                return False
            self.pinned_path = None
            self.cycle_mode = True
            if self.snapshot is None:  # waiting / image-gone: waiting state
                self.show_waiting(None)
            now = time.monotonic()
            self.cycle_interval_start = now
            self.cycle_deadline = now + self.cycle_s
            if self._cycle_tick_id is None:
                self._cycle_tick_id = GLib.timeout_add(CYCLE_CHECK_MS,
                                                       self._cycle_tick)
            self._update_cycle_indicator()
            return True

        def _cycle_stop(self):
            """Exit cycle mode (R27): disarm the deadline check, clear the
            state, refresh the indicator. Every mode-selecting key stops
            the cycle first, then applies its normal semantics; also on
            shutdown."""
            if not self.cycle_mode:
                return
            self.cycle_mode = False
            self.start_oldest = False
            self.cycle_deadline = None
            self.cycle_interval_start = None
            self._cycle_first_req = None
            if self._cycle_tick_id is not None:
                GLib.source_remove(self._cycle_tick_id)
                self._cycle_tick_id = None
            self._update_cycle_indicator()

        def _cycle_request(self, path):
            """One cycle decode (R27): an ordinary dual-buffered request
            unless the displayed snapshot already is this exact version
            (the single-settled-image case: the cycle holds)."""
            obs = self.observer.get(path)
            if (self.snapshot is not None and path == self.snapshot.path
                    and obs is not None
                    and obs.mtime_ns == self.snapshot.mtime_ns
                    and obs.size == self.snapshot.size):
                return
            self.current_gen += 1
            self.decoder.request(self.current_gen, path, *self.decode_target())

        def _cycle_tick(self):
            """Cycle deadline check (R27/R28, §12.5): the CYCLE_CHECK_MS
            main-thread timeout. When the deadline has passed, scan, pick
            the advance target (first slide when no display is up; else
            the adjacent newer settled candidate, wrapping to the oldest,
            skipping failed versions), and issue one decode request.
            Fixed-period deadline: each advance reschedules at
            now + cycle_s; new-image arrivals and decode failures do not
            reset the clock."""
            if not self.cycle_mode:
                self._cycle_tick_id = None
                return False
            now = time.monotonic()
            if self.cycle_deadline is not None and now < self.cycle_deadline:
                return True
            cands = scan_candidates(self.dir_abs, self.exts)
            now_wall = time.time()
            update_observed(self.observer, cands, now, now_wall)
            settled = [c for c in cands
                       if is_settled(self.observer[c[0]], now, now_wall,
                                     self.window_s)]
            ordered = order_cands(settled)
            if not ordered:
                if self.snapshot is None and not self.image_gone:
                    self.show_waiting(None)
                self.cycle_deadline = now + self.cycle_s
                return True
            if self.snapshot is None:
                # No display yet (armed `c` / --cycle, or resuming after
                # the list went empty, R27/R29): the first slide; the
                # interval starts at this display.
                if self._cycle_first_req is not None:
                    return True  # in flight; the deadline backstops it
                target = cycle_first(ordered, self.start_oldest,
                                     self.failed_versions)
                if target is None:
                    self.show_waiting(None)  # every candidate failed (R15)
                    self.cycle_deadline = now + self.cycle_s
                    return True
                self.start_oldest = False
                obs = self.observer.get(target)
                self._cycle_first_req = (target,
                                         obs.mtime_ns if obs else -1,
                                         obs.size if obs else -1)
                self.cycle_interval_start = now
                self.cycle_deadline = now + self.cycle_s
            else:
                anchor = nav_anchor(ordered, self.snapshot.path,
                                    self.snapshot)
                target = cycle_target(ordered, anchor, self.failed_versions)
                self.cycle_interval_start = now
                self.cycle_deadline = now + self.cycle_s
            if target is not None:
                self._cycle_request(target)
            return True

        def _cycle_adjust(self, delta):
            """Up/Down: ±1 s on the cycle time (R28). Works during and
            outside cycle mode; while cycling the CURRENT interval is
            rescaled — the elapsed time is preserved (remaining = new
            time − elapsed; a new time below the elapsed advances at the
            next tick) — and every following interval is the new full
            cycle time. The 1 s floor makes Down a no-op (the deadline
            is untouched). Returns whether the cycle time changed (R30
            feedback)."""
            interval_start = self.cycle_interval_start or time.monotonic()
            new, remaining = cycle_rescale(self.cycle_s,
                                           time.monotonic() - interval_start,
                                           delta)
            if remaining is None:
                return False  # floor: no effect
            self.cycle_s = new
            if self.cycle_mode:
                self.cycle_deadline = time.monotonic() + remaining
            self._update_cycle_indicator()
            return True

        def _cycle_suffix(self):
            """The `· cycle Ns` subtitle part (R28) — '' outside cycle
            mode; the whole header is hidden in --fullscreen (R16)."""
            if self.cycle_mode:
                return f" · cycle {self.cycle_s}s"
            return ""

        def _update_cycle_indicator(self):
            """Refresh the header subtitle with the cycle indicator
            (R28): the current subtitle's base + the suffix (hidden in
            --fullscreen, R16)."""
            if self.fullscreen_mode:
                return
            if self.snapshot is not None and self._dims is not None:
                ts = time.strftime("%Y-%m-%d %H:%M:%S",
                                   time.localtime(self.snapshot.mtime_ns
                                                  / 1e9))
                base = (f"{self._dims[0]}×{self._dims[1]}  ·  {ts}")
            else:
                base = self._subtitle
            self.title_widget.set_subtitle(base + self._cycle_suffix())

        # -- display state (spec §5.4, R8, R10, R23) ----------------------------
        def show_waiting(self, error_path):
            self.picture.set_paintable(None)
            self.snapshot = None
            self.image_gone = False
            if error_path:
                self.waiting_label.set_text(
                    f"Could not load {os.path.basename(error_path)} — see stderr")
            elif self.mode == "file":
                self.waiting_label.set_text(
                    f"Waiting for {self.file_name} to settle…")
            else:
                self.waiting_label.set_text("Waiting for images…")
            self.waiting_label.set_visible(not self.fullscreen_mode)  # R16
            self.title_widget.set_title("riview")
            self.title_widget.set_subtitle(self._subtitle
                                           + self._cycle_suffix())
            self.set_title("riview")

        def show_image_gone(self):
            """R23/§5.5: the pinned file ceased to be a candidate — black
            canvas + explanatory message (hidden in --fullscreen, R16).
            The pin persists; the display is restored when the file
            reappears and settles, or on `n`."""
            self.picture.set_paintable(None)
            self.snapshot = None
            self.image_gone = True
            self.waiting_label.set_text(IMAGE_GONE_TEXT)
            self.waiting_label.set_visible(not self.fullscreen_mode)  # R16
            self.title_widget.set_title("riview")
            self.title_widget.set_subtitle(self._subtitle
                                           + self._cycle_suffix())
            self.set_title("riview")

        def _pump(self):
            for gen, path, pixbuf, error in self.decoder.results():
                if gen != self.current_gen:
                    continue  # superseded (design §12.5)
                if error is not None:
                    self._on_load_error(path, error)
                else:
                    self._on_load_ok(path, pixbuf)
            return True

        def _on_load_ok(self, path, pixbuf):
            # R24 fit pass — once, on the first displayed load, before the
            # swap so size + image land together (§12.7). Skipped in
            # --fullscreen and "off" mode; latched when it first applies
            # (a later --fullscreen exit re-arms it via the next load).
            if (not self.fitted and self.fit_mode != "off"
                    and not self.fullscreen_mode):
                box = self._monitor_box()
                if box is not None:
                    # The fit is measured on the image's ORIGINAL pixel
                    # dimensions (1:1 semantics for "exact"), probed from
                    # the header; the displayed pixbuf is a scaled copy
                    # (decode target = 2× scale factor × window).
                    dims = probe_dimensions_file(path)
                    if dims is None:
                        dims = (pixbuf.get_width(), pixbuf.get_height())
                    size = fit_window(self.fit_mode, dims[0], dims[1], *box)
                    _dbg(f"fit pass: dims={dims} box={box} -> {size}")
                    if size is not None:
                        _resize_window(self, *size)
                self.fitted = True
            obs = self.observer.get(path)
            mtime = obs.mtime_ns if obs else 0
            size = obs.size if obs else 0
            self.snapshot = Snapshot(path, mtime, size,
                                     pixbuf.get_width(), pixbuf.get_height())
            self.image_gone = False
            _dbg(f"image displayed: {os.path.basename(path)} "
                 f"{pixbuf.get_width()}x{pixbuf.get_height()}")
            # set_paintable + texture: the non-deprecated display API
            # (set_pixbuf is deprecated in GTK >= 4.10; a Pixbuf itself is
            # not a Gdk.Paintable, so wrap it in a texture — §13.2).
            self.picture.set_paintable(Gdk.Texture.new_for_pixbuf(pixbuf))
            self.waiting_label.set_visible(False)
            self._cycle_first_req = None
            self._dims = (pixbuf.get_width(), pixbuf.get_height())
            self.title_widget.set_title(os.path.basename(path))
            ts = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(mtime / 1e9))
            self.title_widget.set_subtitle(
                f"{pixbuf.get_width()}×{pixbuf.get_height()}  ·  {ts}"
                + self._cycle_suffix())
            self.set_title(os.path.basename(path))

        def _on_load_error(self, path, error):
            obs = self.observer.get(path)
            version = (path, obs.mtime_ns if obs else -1, obs.size if obs else -1)
            if version not in self.failed_versions:  # warn once per version (R15)
                self.failed_versions.add(version)
                print(f"riview: warning: could not load {path}: {error}",
                      file=sys.stderr)
            if self.snapshot is None:
                self._cycle_first_req = None  # first slide failed: the next
                # advance reselects (failed versions are skipped, R15)
                self.show_waiting(path)
            # else: dual buffer — the current image stays (R7)

        # -- keyboard shortcuts (R18, R23, design §12.9) -----------------
        def _on_key(self, controller, keyval, keycode, state):
            """q = quit; f = toggle full screen; Esc = leave full screen;
            Left/Right = manual navigation; n = back to the newest (R23);
            Home/End = jump to the oldest/newest, pinned (R25);
            p = pause — pin the displayed image (R26);
            r = re-fit the window to the displayed image (R24);
            c = start cycle mode, the slide show (R27);
            Up/Down = ±1 s on the cycle time (R28).
            In full screen (R16), the effective c/p/n/Up/Down keypresses
            show a 1 s on-canvas overlay — the header is the feedback
            channel in windowed mode (R30, §5.8).

            Bare keys only: any modifier beyond Shift/locks leaves the event
            unhandled (Ctrl+q etc. are not shortcuts, §11 case 23). Works in
            windowed and full-screen mode alike. In cycle mode (R27), every
            mode-selecting key — Left/Right/Home/End/p/n — stops the cycle
            first, then applies its normal semantics; f/Esc/r/double-click
            do not affect it; Up/Down adjust the cycle time.
            """
            if int(state) & ~self._PERMITTED_MODS:
                return False
            if keyval in (Gdk.KEY_q, Gdk.KEY_Q):
                self.close()
                return True
            if keyval in (Gdk.KEY_f, Gdk.KEY_F):
                self._set_fullscreen(not self.fullscreen_mode)
                return True
            if keyval == Gdk.KEY_Escape and self.fullscreen_mode:
                self._set_fullscreen(False)
                return True
            if keyval == Gdk.KEY_Left:
                self._cycle_stop()  # cycle mode: exit first (R27)
                self._nav(-1)
                return True
            if keyval == Gdk.KEY_Right:
                self._cycle_stop()  # cycle mode: exit first (R27)
                self._nav(+1)
                return True
            if keyval in (Gdk.KEY_n, Gdk.KEY_N):
                was_cycling = self.cycle_mode
                self._cycle_stop()  # cycle mode: exit first (R27)
                if was_cycling:
                    # Live mode resumes (R3): select the newest now.
                    if self.watcher is not None:
                        self.watcher.schedule_rescan(0)
                    effective = True
                else:
                    effective = self._back_to_newest()
                self._show_feedback(
                    feedback_message("n", effective, self.cycle_s))  # R30
                return True
            if keyval == Gdk.KEY_Home:
                self._cycle_stop()  # cycle mode: exit first (R27)
                self._jump("oldest")
                return True
            if keyval == Gdk.KEY_End:
                self._cycle_stop()  # cycle mode: exit first (R27)
                self._jump("newest")
                return True
            if keyval in (Gdk.KEY_p, Gdk.KEY_P):
                self._cycle_stop()  # cycle mode: stop and pin (R26)
                engaged = self._pause()
                self._show_feedback(
                    feedback_message("p", engaged, self.cycle_s))  # R30
                return True
            if keyval in (Gdk.KEY_r, Gdk.KEY_R):
                self._refit()  # display key: cycle mode keeps running
                return True
            if keyval in (Gdk.KEY_c, Gdk.KEY_C):
                started = self._cycle_start()  # no-op while already cycling
                self._show_feedback(
                    feedback_message("c", started, self.cycle_s))  # R30
                return True
            if keyval == Gdk.KEY_Up:
                changed = self._cycle_adjust(+1)  # R28: in/out of cycle mode
                self._show_feedback(
                    feedback_message("up", changed, self.cycle_s))  # R30
                return True
            if keyval == Gdk.KEY_Down:
                changed = self._cycle_adjust(-1)  # R28: 1 s floor
                self._show_feedback(
                    feedback_message("down", changed, self.cycle_s))  # R30
                return True
            return False

        def _nav(self, direction):
            """Left/Right: two-phase movement (rev 1.5, R23, §5.5).

            Attempt: one step toward the older (direction -1) / newer
            (+1) end from the anchor — where the displayed version sorts
            in the current navigation list by (mtime, path); when the
            displayed file is not a settled candidate (image-gone state,
            rewrite in flight) the anchor is its last known (mtime, path).
            Pin: whatever is displayed is pinned — a failed attempt
            therefore freezes the live display (exiting live mode), and
            in manual mode the pin is simply unchanged. A decode request
            is issued only when the attempt resolves to a different
            candidate. No effect in single-file mode (R21) and the idle
            state (R22); in the waiting state there is nothing to pin.
            """
            if self.mode != "dir" or self.decoder is None:
                return
            cands = scan_candidates(self.dir_abs, self.exts)
            now_mono = time.monotonic()
            now_wall = time.time()
            # Keep the observer current: a file rewritten since the last
            # rescan must not count as settled on its *old* observed state.
            update_observed(self.observer, cands, now_mono, now_wall)
            settled = [c for c in cands
                       if is_settled(self.observer.get(c[0]), now_mono,
                                     now_wall, self.window_s)]
            ordered = order_cands(settled)
            cur = (self.pinned_path if self.pinned_path is not None
                   else (self.snapshot.path if self.snapshot else None))
            if cur is None:
                return  # waiting state: nothing displayed, nothing to pin
            target = nav_target(ordered,
                                nav_anchor(ordered, cur, self.snapshot),
                                direction)
            if target is not None and target != cur:
                self.pinned_path = target
                # A normal decode request through the existing pipeline:
                # the display is touched only in _on_load_ok (§5.4,
                # dual buffer).
                self.current_gen += 1
                self.decoder.request(self.current_gen, target,
                                     *self.decode_target())
            else:
                # Failed attempt (nothing on that side of the anchor, or
                # no settled candidates): the display is unchanged — pin
                # it anyway (R23, rev 1.5).
                self.pinned_path = cur

        def _jump(self, which):
            """Home/End: two-phase movement (rev 1.5, R25, §5.5).

            Attempt: jump to the oldest ("oldest") / newest ("newest")
            settled candidate — absolute ends, no position anchor needed.
            Pin: whatever is displayed is pinned — in live mode the key
            therefore always exits live mode (at the matching end, or
            with a single settled image, the attempt makes no change and
            the current display is pinned in place). Recovers the
            image-gone state on the corresponding end (stays manual). No
            effect in single-file mode (R21); in the waiting state there
            is nothing to pin.
            """
            if self.mode != "dir" or self.decoder is None:
                return
            cands = scan_candidates(self.dir_abs, self.exts)
            now_mono = time.monotonic()
            now_wall = time.time()
            update_observed(self.observer, cands, now_mono, now_wall)
            settled = [c for c in cands
                       if is_settled(self.observer.get(c[0]), now_mono,
                                     now_wall, self.window_s)]
            ordered = order_cands(settled)
            cur = (self.pinned_path if self.pinned_path is not None
                   else (self.snapshot.path if self.snapshot else None))
            if cur is None:
                return  # waiting state: nothing displayed, nothing to pin
            target = None
            if ordered:
                target = ordered[0][0] if which == "newest" \
                    else ordered[-1][0]
            if target is not None and target != cur:
                self.pinned_path = target
                # A normal decode request through the existing pipeline:
                # the display is touched only in _on_load_ok (§5.4,
                # dual buffer).
                self.current_gen += 1
                self.decoder.request(self.current_gen, target,
                                     *self.decode_target())
            else:
                # No change (already at that end, a single settled image,
                # or no settled candidates): pin the display anyway.
                self.pinned_path = cur

        def _pause(self):
            """p: pause (R26, §5.5) — pin whatever image is displayed,
            with no movement attempt. In live mode this freezes the
            stream on the current image (newer files no longer displace
            it; an in-place update of the pinned file still reloads once
            settled, R4). In manual mode and the image-gone state the pin
            already is the display — no observable effect; in the waiting
            state there is nothing to pin. No effect in single-file mode
            (R21) and the idle state (R22). Returns whether the pin
            actually engaged (R30 feedback: manual mode, image-gone and
            the waiting state are no-ops → no overlay)."""
            if self.mode != "dir" or self.decoder is None:
                return False
            cur = (self.pinned_path if self.pinned_path is not None
                   else (self.snapshot.path if self.snapshot else None))
            if cur is not None and self.pinned_path != cur:
                self.pinned_path = cur
                return True
            return False

        def _back_to_newest(self):
            """n: back to live mode — the newest settled image (R23, §5.5);
            also exits the image-gone state. No-op when already in live
            mode (and in single-file / idle modes, where a pin can never
            exist). Returns whether live mode was actually resumed (R30
            feedback)."""
            if self.pinned_path is None and not self.image_gone:
                return False
            self.pinned_path = None
            if self.watcher is not None:
                self.watcher.schedule_rescan(0)  # select the newest now
            return True

        def _refit(self):
            """r: re-fit the window to the currently displayed image
            (R24, §5.6). No-op in "off" mode, in --fullscreen, and when
            no image is displayed (waiting/idle/image-gone). Does not
            touch fitted or pinned_path, and issues no rescan."""
            if (self.fit_mode == "off" or self.fullscreen_mode
                    or self.snapshot is None):
                return
            box = self._monitor_box()
            if box is None:
                return
            dims = probe_dimensions_file(self.snapshot.path) \
                if getattr(self.snapshot, "path", None) else None
            if dims is None:
                dims = (self.snapshot.width, self.snapshot.height)
            size = fit_window(self.fit_mode, dims[0], dims[1], *box)
            _dbg(f"refit: dims={dims} box={box} -> {size}")
            if size is not None:
                _resize_window(self, *size)

        def _set_fullscreen(self, on):
            # We are the only code that changes full-screen state, so the
            # flag is the source of truth (no is_fullscreened() in the
            # binding, §13.2). Header bar follows the mode (R16); an
            # active feedback overlay is dismissed immediately — the
            # feedback channel switches with the mode (R30).
            self.fullscreen_mode = on
            self.header.set_visible(not on)
            self._feedback_hide()
            if on:
                self.fullscreen()
            else:
                self.unfullscreen()

        def _on_canvas_click(self, gesture, n_presses, x, y):
            """R19: a left double-click on the canvas toggles full screen,
            same as `f`. The binding has no Gtk.GestureMultiPress /
            EventControllerPointer (§13.2), so the double-click is detected
            manually: two left presses within DOUBLE_CLICK_S.
            """
            now = time.monotonic()
            if now - self._last_canvas_click_s <= DOUBLE_CLICK_S:
                self._last_canvas_click_s = -1.0
                self._set_fullscreen(not self.fullscreen_mode)
            else:
                self._last_canvas_click_s = now

    class RiviewApp(Adw.Application):
        def __init__(self, args):
            super().__init__(application_id=APP_ID,
                             flags=Gio.ApplicationFlags.NON_UNIQUE)
            self.args = args
            self.window = None
            self.error = None  # set if window construction fails in do_activate
            # Ctrl+C / SIGTERM → clean quit (R18, §11 case 22). C-level
            # handlers replace Python's KeyboardInterrupt path.
            for sig in (signal.SIGINT, signal.SIGTERM):
                GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, self._on_signal)

        def do_activate(self):
            # Window construction happens here (not in run_gui) so that it
            # runs inside the GApplication context; failures are captured
            # because GApplication swallows exceptions from signal handlers.
            if self.window is None and self.error is None:
                try:
                    self.window = RiviewWindow(self, self.args)
                    if self.args.fullscreen:
                        self.window.fullscreen()
                    self.window.present()
                except Exception as e:
                    self.error = e
                    self.quit()

        def _on_signal(self, signum):
            self.quit()
            return False  # one-shot

        def do_shutdown(self):
            if self.window is not None:
                if getattr(self.window, "cycle_mode", False):
                    self.window._cycle_stop()
                self.window._feedback_hide()
                if self.window.watcher is not None:
                    self.window.watcher.stop()
                if self.window.decoder is not None:
                    self.window.decoder.stop()
                self.window = None
            Gio.Application.do_shutdown(self)

    return Decoder, Watcher, RiviewWindow, RiviewApp


def run_gui(args):
    Decoder, Watcher, RiviewWindow, RiviewApp = _gui_classes()
    app = RiviewApp(args)
    rc = app.run(None)
    if app.error is not None:
        print(f"riview: error: {app.error}", file=sys.stderr)
        return INTERNAL
    return rc


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    args = build_parser().parse_args(_cycle_argv(argv))
    if args.version:
        print(f"riview {VERSION}")
        return OK
    try:
        if args.install_desktop or args.uninstall_desktop:
            return run_desktop_install(args)
        validate(args)
        # --print ignores the launch context: no target → CWD, always (§4.3).
        gui_ctx = is_gui_context() if not args.print else False
        mode, path = resolve_target(args.target, gui_ctx)
    except UsageError as e:
        print(f"riview: error: {e}", file=sys.stderr)
        return USAGE
    except NoTargetError as e:
        print(f"riview: error: target does not exist: {e.path}",
              file=sys.stderr)
        return NO_TARGET
    if mode == "none" and args.fullscreen:
        print("riview: error: --fullscreen requires a target (no target "
              "given in a GUI context)", file=sys.stderr)
        return USAGE
    if args.print:
        return run_print(mode, path, args)
    args.mode = mode
    args.target_abs = path
    try:
        return run_gui(args)
    except Exception as e:
        print(f"riview: error: {e}", file=sys.stderr)
        return INTERNAL


if __name__ == "__main__":
    sys.exit(main())
