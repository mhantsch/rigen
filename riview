def parse_extensions(spec):
    """Parse an --extensions value into a set (spec §4.1/§4.2)."""
    if spec is None:
        return set(DEFAULT_EXTENSIONS.split(","))
    tokens = [t.strip().lower() for t in spec.split(",")]
    tokens = [t for t in tokens if t != ""]
    if not tokens:
        raise UsageError("--extensions: empty list")
    for t in tokens:
        if "/" in t:
            raise UsageError(f"--extensions: '{t}' contains '/'")
        if t.startswith("."):
            raise UsageError(f"--extensions: '{t}' must not start with '.'")
    return set(tokens)


def extension_of(name):
    if "." not in name:
        return None
    return name.rsplit(".", 1)[1].lower()


def scan_candidates(dir_path, exts):
    """List the candidates of dir_path (spec §5.1).

    Returns [(path, mtime_ns, size)] with absolute paths. Never raises:
    a missing/unreadable directory yields [].
    """
    out = []
    try:
        entries = list(os.scandir(dir_path))
    except OSError:
        return out
    for entry in entries:
        name = entry.name
        if name.startswith("."):
            continue
        ext = extension_of(name)
        if ext is None or ext not in exts:
            continue
        try:
            st = entry.stat(follow_symlinks=True)
        except OSError:
            continue  # broken symlink etc.; may become valid on a later rescan
        if not statmod.S_ISREG(st.st_mode):
            continue
        out.append((os.path.join(dir_path, name), st.st_mtime_ns, st.st_size))
    return out


class Observed:
    """Per-path observed state (spec §5.3)."""
    __slots__ = ("mtime_ns", "size", "last_change_mono")

    def __init__(self, mtime_ns, size, last_change_mono):
        self.mtime_ns = mtime_ns
        self.size = size
        self.last_change_mono = last_change_mono


def update_observed(obs_map, cands, now_mono, now_wall):
    """Update per-path observed state (spec §5.3). Mutates and returns obs_map."""
    seen = set()
    for path, mtime_ns, size in cands:
        seen.add(path)
        prev = obs_map.get(path)
        if prev is None:
            # First sighting: presume the last change happened at the file's
            # own mtime (clamped to now) — the mtime-age fast path (§5.3):
            # a pre-existing file older than the window settles immediately.
            age = max(0.0, now_wall - mtime_ns / 1e9)
            obs_map[path] = Observed(mtime_ns, size, now_mono - age)
        elif (prev.mtime_ns, prev.size) != (mtime_ns, size):
            obs_map[path] = Observed(mtime_ns, size, now_mono)
        # else: unchanged — keep last_change_mono
    for p in [p for p in obs_map if p not in seen]:
        del obs_map[p]
    return obs_map


def is_settled(obs, now_mono, now_wall, window_s):
    """Spec §5.3: quiet for the settle window by both observed and mtime age."""
    if obs is None:
        return False
    return ((now_mono - obs.last_change_mono >= window_s)
            and (now_wall - obs.mtime_ns / 1e9 >= window_s))


class Snapshot:
    """Identity of the currently displayed image (spec §2)."""
    __slots__ = ("path", "mtime_ns", "size", "width", "height")

    def __init__(self, path, mtime_ns, size, width=0, height=0):
        self.path = path
        self.mtime_ns = mtime_ns
        self.size = size
        self.width = width
        self.height = height


def pick_best(settled, snapshot):
    """Spec §5.2: which path belongs on display, or None.

    settled: [(path, mtime_ns, size)]; snapshot: Snapshot | None.
    """
    if not settled:
        return None
    cur_unchanged = False
    if snapshot is not None:
        for path, mtime_ns, size in settled:
            if path == snapshot.path:
                if (mtime_ns, size) == (snapshot.mtime_ns, snapshot.size):
                    cur_unchanged = True
                else:
                    # In-place update of the displayed file (R4): reload it,
                    # whatever the mtime direction.
                    return path
                break
    if cur_unchanged:
        # Switch to a *different* file only if strictly newer (newer-only).
        newer = [c for c in settled
                 if c[0] != snapshot.path and c[1] > snapshot.mtime_ns]
        if newer:
            return max(newer, key=lambda c: (c[1], c[0]))[0]
        return snapshot.path
    # No valid current: the overall newest (ties → lexicographically greatest).
    return max(settled, key=lambda c: (c[1], c[0]))[0]


def newest_for_report(cands):
    """`--print` (spec §4.3): greatest mtime; ties → greatest name. No settle."""
    if not cands:
        return None
    return max(cands, key=lambda c: (c[1], c[0]))[0]


def order_cands(cands):
    """Navigation list (spec §5.5): the settled candidates in §4.3 order —
    greatest mtime first, ties broken by byte-wise greatest filename.
    Index 0 is the newest entry."""
    return sorted(cands, key=lambda c: (c[1], c[0]), reverse=True)


def nav_anchor(ordered, cur, snapshot):
    """(path, mtime) anchor of the displayed version (rev 1.5, §5.5).

    The candidate's own entry when `cur` is in `ordered`; otherwise the
    virtual position of the last known (mtime, path) of `cur` — from
    `snapshot` when it is the displayed file — for the image-gone state
    (the pin holds its last mtime) and a rewrite in flight.
    """
    for path, mtime, _size in ordered:
        if path == cur:
            return (path, mtime)
    if snapshot is not None and getattr(snapshot, "path", None) == cur:
        return (cur, snapshot.mtime_ns)
    return (cur, 0)


def nav_target(ordered, anchor, direction):
    """One navigation step from `anchor` (spec §5.5, rev 1.5, R23).

    ordered: the navigation list from order_cands() (index 0 = newest,
    §4.3 order). anchor: (path, mtime) — where the displayed version
    sorts (nav_anchor); it need not be a list member (image-gone state,
    rewrite in flight).
    direction: -1 = toward the older end (`Left`), +1 = toward the newer
    end (`Right`).

    Returns the first candidate path strictly on that side of the anchor
    (the adjacent step), or None — nothing on that side: the movement
    makes no change (the pin phase still applies, R23).
    """
    apath, amtime = anchor
    if direction < 0:  # older: first candidate sorting after the anchor
        for path, mtime, _size in ordered:
            if (mtime, path) < (amtime, apath):
                return path
    else:  # newer: first candidate sorting before the anchor —
        # iterate from the older end so the first hit is the adjacent step
        for path, mtime, _size in reversed(ordered):
            if (mtime, path) > (amtime, apath):
                return path
    return None


def cycle_target(ordered, anchor, failed_versions):
    """Cycle advance target (spec §5.7, rev 1.6, R27). Pure.

    ordered: the navigation list from order_cands() (index 0 = newest,
    §4.3 order). anchor: (path, mtime) — where the displayed version
    sorts (nav_anchor); it need not be a list member (deleted slide,
    rewrite in flight). failed_versions: the R15 set of (path, mtime,
    size) versions that failed to decode — a failed slide is skipped,
    never retried.

    Returns the first settled candidate strictly newer than the anchor
    (the adjacent newer image), skipping failed versions; when the
    anchor is at the newest end (or only failed versions lie between it
    and the newest), the OLDEST non-failed candidate (the wrap). None
    when the list is empty or every candidate is a failed version.
    """
    if not ordered:
        return None
    apath, amtime = anchor
    for path, mtime, size in reversed(ordered):  # from the older end, so
        # the first hit is the adjacent newer image
        if ((mtime, path) > (amtime, apath)
                and (path, mtime, size) not in failed_versions):
            return path
    for path, mtime, size in reversed(ordered):  # wrap: oldest non-failed
        if (path, mtime, size) not in failed_versions:
            return path
    return None


def cycle_first(ordered, start_oldest, failed_versions):
    """First slide of an armed cycle (R27/R29, §5.7). Pure.

    The oldest (start_oldest — `--cycle` at startup) or newest settled
    candidate, skipping failed versions; None when every candidate is
    a failed version.
    """
    seq = reversed(ordered) if start_oldest else iter(ordered)
    for path, mtime, size in seq:
        if (path, mtime, size) not in failed_versions:
            return path
    return None


def feedback_message(key, effective, cycle_s):
    """R30 (§5.8): the full-screen overlay text for a feedback keypress,
    or None (no overlay).

    key: 'c' | 'p' | 'n' | 'up' | 'down'; effective: whether the keypress
    effected its named change (the §4.4/§5.5/§5.7 no-op rules decide — a
    no-op keypress shows nothing); cycle_s: the current cycle time. The
    overlay is full-screen-only; the caller (Window._show_feedback) applies
    that.
    """
    if not effective:
        return None
    if key == "c":
        return f"cycle on: {cycle_s}s"
    if key == "p":
        return "pause"
    if key == "n":
        return "newest live image"
    if key in ("up", "down"):
        return f"cycle: {cycle_s}s"
    return None


def cycle_rescale(cycle_s, elapsed, delta):
    """Up/Down adjustment of the cycle time (spec R28, rev 1.6). Pure.

    cycle_s: the current cycle time, seconds. elapsed: the in-progress
    interval's elapsed time, seconds. delta: +1 (Up) / -1 (Down).

    Returns (new_cycle_s, remaining): the new cycle time and the seconds
    from *now* to the next advance (deadline = now + remaining). When
    the floor makes the adjustment a no-op (Down at 1 s), remaining is
    None — the in-progress deadline is untouched. A new time shorter
    than the elapsed time yields remaining 0 (advance at the next tick).
    """
    new = max(MIN_CYCLE_S, cycle_s + delta)
    if new == cycle_s:
        return cycle_s, None
    return new, max(0.0, new - elapsed)


def _fit_ratio(img_w, img_h, avail_w, avail_h):
    """Largest rectangle at the image's aspect ratio that fits inside
    (avail_w, avail_h); (w, h) in floats."""
    k = min(avail_w / img_w, avail_h / img_h)
    return img_w * k, img_h * k


def fit_window(mode, img_w, img_h, box_w, box_h, screen_w, screen_h,
               header_h, sf):
    """Window-fit geometry (spec §5.6, R24). Pure.

    mode:       "ratio" | "exact" | "off".
    img_w/h:    the displayed image, physical pixels.
    box_w/h:    the 80% pre-image budget box — the D11 default window size.
    screen_w/h: the monitor the window is on, logical pixels.
    header_h:   the header bar height (canvas = window - header).
    sf:         the window's scale factor (physical px per logical px).

    Returns (win_w, win_h) — the window size = canvas + header — or None
    when no fit applies: "off" mode, a missing monitor box, or no canvas
    room left after the header.
    """
    if mode not in ("ratio", "exact"):
        return None
    if min(img_w, img_h, box_w, box_h, screen_w, screen_h) <= 0:
        return None
    if header_h is None:
        header_h = 0
    sf = sf or 1

    def finish(cw, ch):
        # 320 px-per-side floor, ratio-preserving (spec §5.6). On
        # pathologically small monitors the floor may exceed the budget —
        # the floor wins.
        if cw < FIT_FLOOR or ch < FIT_FLOOR:
            cw, ch = _fit_ratio(img_w, img_h, FIT_FLOOR, FIT_FLOOR)
        return (max(1, int(round(cw))),
                max(1, int(round(ch)) + int(round(header_h))))

    if mode == "ratio":
        # D15: COSMIC clamping workaround — cap the 80 % budget box at a
        # fixed logical size before fitting (the compositor reconfigures
        # windows larger than this; upstream COSMIC bug).
        cap_w = min(box_w, COSMIC_CAP_W)
        cap_h = min(box_h, COSMIC_CAP_H)
        avail_h = cap_h - header_h
        if avail_h <= 0:
            return None
        return finish(*_fit_ratio(img_w, img_h, cap_w, avail_h))

    # exact: 1:1 logical pixels, capped at the full monitor minus the
    # header (a ratio fit within that cap when the image is larger).
    cw, ch = img_w / sf, img_h / sf
    avail_h = screen_h - header_h
    if avail_h <= 0:
        return None
    if cw > screen_w or ch > avail_h:
        cw, ch = _fit_ratio(img_w, img_h, screen_w, avail_h)
    return finish(cw, ch)


def probe_dimensions(data):
    """Intrinsic pixel dimensions from an image header, or None.

    R24 startup fit (§5.6): the window opens at the fit size of the
    first image to be displayed, so the size must be known *before*
    the first decode — from the file header alone (no Pillow, no full
    decode). PNG, JPEG, WebP (VP8 / VP8L / VP8X), GIF, BMP. TIFF and
    unrecognized/truncated input → None (the caller falls back to the
    pre-image default box). Pure: bytes in, values out.
    """
    try:
        if data[:8] == b"\x89PNG\r\n\x1a\n" and len(data) >= 24:
            w = int.from_bytes(data[16:20], "big")
            h = int.from_bytes(data[20:24], "big")
            if 0 < w and 0 < h:
                return w, h
        elif data[:2] == b"\xff\xd8":
            # JPEG: walk segments to the first SOF (height/width follow
            # the precision byte). C4 (DHT), C8 (JPG), CC (DAC) carry
            # no size.
            i = 2
            n = len(data)
            while i + 9 <= n:
                if data[i] != 0xFF:
                    i += 1
                    continue
                m = data[i + 1]
                if 0xC0 <= m <= 0xCF and m not in (0xC4, 0xC8, 0xCC):
                    h = int.from_bytes(data[i + 5:i + 7], "big")
                    w = int.from_bytes(data[i + 7:i + 9], "big")
                    if 0 < w and 0 < h:
                        return w, h
                    break
                if m in (0x00, 0x01, 0xFF) or 0xD0 <= m <= 0xD7:
                    i += 2 if m != 0xFF else 1
                elif i + 4 <= n:
                    i += 2 + int.from_bytes(data[i + 2:i + 4], "big")
                else:
                    break
        elif data[:3] == b"GIF" and len(data) >= 10:
            w = int.from_bytes(data[6:8], "little")
            h = int.from_bytes(data[8:10], "little")
            if 0 < w and 0 < h:
                return w, h
        elif data[:2] == b"BM" and len(data) >= 26:
            w = int.from_bytes(data[18:22], "little", signed=True)
            h = int.from_bytes(data[22:26], "little", signed=True)
            if 0 < abs(w) and 0 < abs(h):
                return abs(w), abs(h)
        elif data[:4] == b"RIFF" and data[8:12] == b"WEBP" and len(data) >= 30:
            chunk = data[12:16]
            if chunk == b"VP8 " and data[20:23] == b"\x9d\x01\x2a":
                # lossy: start code, then 14-bit width and height (LE)
                w = int.from_bytes(data[23:25], "little") & 0x3FFF
                h = int.from_bytes(data[25:27], "little") & 0x3FFF
                if 0 < w and 0 < h:
                    return w, h
            elif chunk == b"VP8L" and data[20] == 0x2F:
                # lossless: signature byte, then bit-packed (w-1, h-1)
                v = int.from_bytes(data[21:25], "little")
                return (v & 0x3FFF) + 1, ((v >> 14) & 0x3FFF) + 1
            elif chunk == b"VP8X":
                # extended: flag byte at 20, then le32 at 21 whose low
                # 14 bits are width-1 and next 14 bits height-1
                v = int.from_bytes(data[21:25], "little")
                return (v & 0x3FFF) + 1, ((v >> 14) & 0x3FFF) + 1
        # TIFF (II*/MM*) is deliberately not probed → None.
        return None
    except Exception:
        return None


def probe_dimensions_file(path, limit=1 << 16):
    """Header-probe dimensions of a file, or None on any failure."""
    try:
        with open(path, "rb") as f:
            data = f.read(limit)
        return probe_dimensions(data)
    except Exception:
        return None


def _monitor_logical_size(mon):
    """Monitor (w, h) in logical pixels, or None (§12.7, §13.2).

    Portable: GTK 4's gir never carried the GTK3-era
    get_width()/get_height(), so the size comes from get_geometry() —
    the monitor's rectangle in the display's coordinate space, in
    logical pixels. Bindings that do expose get_width()/get_height()
    (logical px) also work.
    """
    try:
        geo = mon.get_geometry()
        if geo is not None and geo.width and geo.height:
            return geo.width, geo.height
    except Exception:
        pass
    gw, gh = getattr(mon, "get_width", None), getattr(mon, "get_height", None)
    if callable(gw) and callable(gh):
        try:
            w, h = gw(), gh()
            if w and h:
                return w, h
        except Exception:
            pass
    return None


def _window_size(window):
    """The window's current logical size, or (0, 0) when unobtainable.

    Preference: get_width() / get_height() (GTK >= 4.10 — the widget's
    current allocation; works on mapped windows), then
    get_allocated_width / get_allocated_height (only when get_width is
    absent — on the installed binding the allocated pair is deprecated
    and warns, §13.2), then gtk_window_get_size() — observed reporting
    **0×0 on a mapped window** (Wayland/COSMIC, GTK 4.14.5 / PyGObject
    3.48.2), so it is last resort only.
    """
    get_w = getattr(window, "get_width", None)
    get_h = getattr(window, "get_height", None)
    if callable(get_w) and callable(get_h):
        try:
            w, h = int(get_w()), int(get_h())
            if w > 0 and h > 0:
                return w, h
        except Exception:
            pass
    get_aw = getattr(window, "get_allocated_width", None)
    get_ah = getattr(window, "get_allocated_height", None)
    if callable(get_aw) and callable(get_ah):
        try:
            w, h = int(get_aw()), int(get_ah())
            if w > 0 and h > 0:
                return w, h
        except Exception:
            pass
    try:
        w, h = window.get_size()
        return int(w), int(h)
    except Exception:
        return 0, 0


def _resize_window(window, w, h):
    """Resize the window to w×h logical px (R24, §12.7, §13.2).

    Portable chain:
    - resize(w, h) where the binding exposes it (GTK < 4.14 — the
      mapped-window resize API, deprecated and hidden in 4.14).
    - Before presentation: set_default_size(w, h) — the initial size.
    - After mapping (verified: set_default_size is a no-op on a mapped
      window on this binding / Wayland): set_size_request(w, h) forces
      the window *up* to the target (a size request is a minimum),
      then a short GLib timer releases the clamp (set_size_request(-1,
      -1)) once the size reaches the target or a 2 s deadline passes,
      so the window stays freely user-resizable afterwards. A target at
      or below the current size (within RESIZE_TOL) is a compositor
      decision on Wayland (the client resize API was deprecated in GTK
      4.14) and is left alone. A grow is issued only when the current
      size is *verified* smaller: any min-size change — including the
      later release — can make COSMIC re-apply the window's remembered
      size (§13.2), so a blind grow on an unverifiable (0×0) size is
      skipped.
    """
    resize = getattr(window, "resize", None)
    if callable(resize):
        try:
            resize(w, h)
            return
        except Exception:
            pass
    try:
        mapped = bool(window.get_mapped())
    except Exception:
        mapped = True
    if not mapped:
        _dbg(f"resize {w}x{h}: unmapped -> set_default_size")
        try:
            window.set_default_size(w, h)
        except Exception:
            pass
        return
    cur_w, cur_h = _window_size(window)
    if cur_w <= 0 or cur_h <= 0:
        # Current size unverifiable (observed: gtk_window_get_size →
        # 0×0 on a mapped window on Wayland/COSMIC). Skip: issuing a
        # min-size request that must be released later would itself
        # trigger the compositor's window-size memory (§13.2) — and the
        # window is usually already at the fitted size (early fit).
        _dbg(f"resize {w}x{h}: current size unknown (0x0); skipping grow")
        return
    # A fitted target within RESIZE_TOL of the current size is treated as
    # already achieved: no resize request at all (a min-size change —
    # even a no-op grow that is released again — can make COSMIC
    # re-apply the window's remembered size, §13.2).
    if w <= cur_w + RESIZE_TOL and h <= cur_h + RESIZE_TOL:
        _dbg(f"resize {w}x{h}: within tolerance of {cur_w}x{cur_h}; no-op")
        return
    _dbg(f"resize {w}x{h}: grow from {cur_w}x{cur_h} via size_request")
    try:
        window.set_size_request(w, h)
    except Exception:
        return
    import gi
    gi.require_version("GLib", "2.0")
    from gi.repository import GLib
    start = time.monotonic()

    # NOARGUMENTS: PyGObject calls GLib.timeout_add callbacks with no
    # arguments (the C g_source_func signature does not apply to Python).
    # A TypeError here would leave the size-request clamp in place
    # forever — the window permanently unshrinkable (§13.2).
    def _release():
        try:
            reached = _window_size(window) == (w, h)
        except Exception:
            reached = False
        if not (reached or time.monotonic() - start > 2.0):
            return True
        _dbg(f"clamp released ({'reached' if reached else 'deadline'})")
        try:
            window.set_size_request(-1, -1)
        except Exception:
            pass
        # If the grow was actually reached, do one late check: the
        # compositor may resize the window again after the min-size is
        # released (the COSMIC clamping bug — D15). Log it so the behavior
        # is explainable.
        if reached:
            def _late_check():
                try:
                    final = _window_size(window)
                except Exception:
                    return False
                if final != (w, h):
                    _dbg(f"note: the compositor resized the window to "
                         f"{final[0]}x{final[1]} after the fit to {w}x{h} "
                         f"(COSMIC clamping bug, D15 — see spec §13.2)")
                return False
            GLib.timeout_add(400, _late_check)
        return False

    GLib.timeout_add(50, _release)


# ---------------------------------------------------------------------------
# Launch context & target resolution (rev 0.8; R20–R22, §4.6)
# ---------------------------------------------------------------------------

def has_controlling_tty():
    """True iff this process has a controlling terminal (R22 probe)."""
    try:
        fd = os.open("/dev/tty", os.O_RDONLY)
    except OSError:
        return False
    os.close(fd)
    return True


def is_gui_context(environ=None, has_ctty=None):
    """R22: GUI context ⇔ DESKTOP_STARTUP_ID set, or no controlling terminal.

    Documented convenience heuristic (§4.6). `environ` and `has_ctty` are
    injectable for unit tests; production uses os.environ + a live probe.
    """
    env = os.environ if environ is None else environ
    if env.get("DESKTOP_STARTUP_ID"):
        return True
    if has_ctty is None:
        has_ctty = has_controlling_tty()
    return not has_ctty


def uri_to_path(target):
    """Accept `file://` URIs as targets (the .desktop entry's %U, R20)."""
    if target.startswith("file://"):
        return urllib.parse.unquote(urllib.parse.urlparse(target).path)
    return target


def resolve_target(raw_target, gui_context):
    """Resolve the target to (mode, abs_path); mode in {"dir","file","none"}.

    R21: dir -> directory mode; image file -> single-file mode (default
    extension set only); other file -> UsageError (exit 2); missing ->
    NoTargetError (exit 3). R22: no target -> CWD in a terminal context,
    idle state ("none") in a GUI context.
    """
    if raw_target is not None:
        path = os.path.abspath(uri_to_path(raw_target))
        if not os.path.exists(path):
            raise NoTargetError(path)
        if os.path.isdir(path):
            return "dir", path
        if extension_of(os.path.basename(path)) in DEFAULT_EXTENSIONS_SET:
            return "file", path
        raise UsageError(
            "target is not a directory or a supported image file: " + path)
    if gui_context:
        return "none", None
    return "dir", os.path.abspath(".")


