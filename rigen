#!/usr/bin/env python3
"""rigen — Rapid Image GENeration.

A thin, scriptable command-line client for the local Lemonade image-generation
backend (lemond). Stdlib only. See RIGEN-SW-SPECIFICATION.md / RIGEN-SW-DESIGN.md.
"""

from __future__ import annotations

import argparse
import base64
import binascii
import json
import math
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

VERSION = "1.0.0"
PROG = "rigen"

# Exit codes (spec §8)
EXIT_OK = 0
EXIT_INTERNAL = 1
EXIT_USAGE = 2
EXIT_NO_WORK = 3
EXIT_BACKEND_ERR = 4
EXIT_UNREACHABLE = 5

DEFAULT_BASE_URL = "http://127.0.0.1:13305"
DEFAULT_FMT = "{model}_{prompt}_{batch_idx}.{ext}"
DEFAULT_EXT = "png"
GEN_ENDPOINT = "/api/v1/images/generations"
MODELS_ENDPOINT = "/v1/models"
TS_DEFAULT_FMT = "%Y%m%dT%H%M%SZ"

# Unicode dashes mapped to ASCII '-' in filenames (design decision D2)
UNICODE_DASHES = "\u2010\u2011\u2012\u2013\u2014\u2015\u2212"

PLACEHOLDER_INTS = {"prompt", "model_idx", "prompt_idx", "batch_idx", "image_idx"}
PLACEHOLDER_NAMES = {"model", "ext", "timestamp"} | PLACEHOLDER_INTS


class UsageError(Exception):
    """Validation / usage failure (exit 2). Message is printed verbatim to stderr."""


class NoWorkError(Exception):
    """Nothing to do (exit 3)."""


class InternalError(Exception):
    """Unexpected internal failure (exit 1)."""


class BackendUnreachable(Exception):
    """Connection-level failure (exit 5)."""


class BackendError(Exception):
    """Backend responded with an error (batch failure)."""


def format_hms(seconds: float) -> str:
    """Zero-padded HH:MM:SS (hours unbounded), rounded to the nearest second."""
    s = max(0, round(seconds))
    h, rem = divmod(s, 3600)
    m, s = divmod(rem, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


def progress_label(done: int, total: int, eta: float | None = None) -> str:
    """Progress token, e.g. `[2/5 (40%)]` or `[2/5 (40%) 00:03:12 remaining]`.

    The ETA is omitted when it cannot yet be calculated (`eta is None`).
    """
    label = f"[{done}/{total} ({100 * done // total}%)"
    if eta is not None:
        label += f" {format_hms(eta)} remaining"
    return label + "]"


class Progress:
    """Human progress on stderr (suppressed by --quiet; errors always print)."""

    def __init__(self, quiet: bool, verbose: bool = False) -> None:
        self.quiet = quiet
        self.verbose = verbose

    def say(self, msg: str) -> None:
        if not self.quiet:
            sys.stderr.write(f"{PROG}: {msg}\n")
            sys.stderr.flush()

    def say_wrapped(self, msg: str, width: int = 120, prefix: str = " > ") -> None:
        # Intentionally NOT suppressed by --quiet: --quiet hides the progress lines,
        # but --verbose prompt text stays visible (design decision D10).
        if self.verbose:
            for line in msg.splitlines():
                # wrap each line to the given width, breaking at word boundaries if possible
                while len(line) > width:
                    # find the last whitespace before the width limit
                    break_pos = line.rfind(" ", 0, width)
                    if break_pos == -1:
                        break_pos = width  # no whitespace found, hard break
                    sys.stderr.write(f"{prefix}{line[:break_pos]}\n")
                    line = line[break_pos:].lstrip()  # remove leading whitespace for next line
                sys.stderr.write(f"{prefix}{line}\n")
            sys.stderr.flush()

    def err(self, msg: str) -> None:
        sys.stderr.write(f"{PROG}: {msg}\n")
        sys.stderr.flush()


